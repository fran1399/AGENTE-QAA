{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lead Consolidation Report",
  "description": "QA Lead consolidation. Canonical source: docs/AGENT-CONTRACTS.md. Must separate confirmed / uncertain / not verified / blocked.",
  "type": "object",
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "risk_summary": { "type": "string" },
    "inputs_by_agent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent": { "enum": ["qa-lead", "test-designer", "exploratory-qa", "risk-analyst", "test-executor", "test-data", "bug-analyst", "qa-reviewer"] },
          "output_ref": { "type": "string" },
          "status": { "enum": ["received", "not_received"] }
        },
        "required": ["agent", "status"],
        "additionalProperties": true
      }
    },
    "conflicts": { "type": "array" },
    "confirmed_findings": { "type": "array" },
    "uncertain_findings": { "type": "array" },
    "not_verified": { "type": "array" },
    "blocked": { "type": "array" },
    "final_conclusion": { "type": "string", "minLength": 1 },
    "reviewer_verdict": { "type": "object" },
    "confidence": { "$ref": "_common.schema.json#/$defs/confidence" },
    "confidence_rationale": { "type": "string" },
    "evidence_index": { "type": "array" },
    "uncertainties": { "type": "array" }
  },
  "required": ["objective", "final_conclusion", "confidence"],
  "additionalProperties": true
}
